<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CustomSpellChecker</RootNamespace>
    <AssemblyName>CustomSpellCheckerVB</AssemblyName>
    <!-- WindowsFormsWithCustomSubMain: keep My.Application WinForms helpers but suppress
         the auto-generated My.MyApplication.Main so Program.vb's explicit Sub Main is the
         sole entry point (avoids BC30737). -->
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>CustomSpellChecker.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <!-- The control's own NuGet package ships a high-DPI app.manifest by design; silence the
         build hint suggesting ApplicationHighDpiMode instead, which would conflict with it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="Content">
    <Content Include="underline.gif">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WinForms" Version="*" />
  </ItemGroup>

  <!-- Visual Studio works out which files are forms on its own for the modern .NET targets,
       but not for a .NET Framework target: there the SubType has to be declared, or the file
       shows a plain code icon and double-click opens the code instead of the designer.
       Copy this block into your own SDK-style .NET Framework project. -->
  <ItemGroup>
    <Compile Update="MainForm.vb">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
