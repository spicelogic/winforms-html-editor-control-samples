<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DataBinding</RootNamespace>
    <AssemblyName>DataBinding</AssemblyName>
    <!-- The control's own NuGet package ships a high-DPI app.manifest by design; silence the
         build hint suggesting ApplicationHighDpiMode instead, which would conflict with it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WinForms" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sample-students.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
