<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CustomContextMenuVB</RootNamespace>
    <AssemblyName>CustomContextMenuVB</AssemblyName>
    <StartupObject>CustomContextMenuVB.Program</StartupObject>
    <!-- The control's own NuGet package ships a high-DPI app.manifest by design; silence the
         build hint suggesting ApplicationHighDpiMode instead, which would conflict with it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WinForms" Version="*" />
  </ItemGroup>

</Project>
