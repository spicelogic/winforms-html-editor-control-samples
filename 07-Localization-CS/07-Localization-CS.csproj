<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LocalizationSample</RootNamespace>
    <AssemblyName>Localization</AssemblyName>
    <!-- The control's own NuGet package ships a high-DPI app.manifest by design; silence the
         build hint suggesting ApplicationHighDpiMode instead, which would conflict with it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WinForms" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SpiceLogic.HtmlEditor.Localization\EditorStrings.pl-PL.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Reference catalog + docs for the JSON override feature: shown in Solution Explorer,
         not copied to output (not loaded at runtime, only read by the developer). -->
    <None Include="SpiceLogic.HtmlEditor.Localization\_OVERRIDABLE-KEYS.reference.json" />
    <None Include="SpiceLogic.HtmlEditor.Localization\README.md" />
    <Content Include="underline.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Visual Studio works out which files are forms on its own for the modern .NET targets,
       but not for a .NET Framework target: there the SubType has to be declared, or the file
       shows a plain code icon and double-click opens the code instead of the designer.
       Copy this block into your own SDK-style .NET Framework project. -->
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
