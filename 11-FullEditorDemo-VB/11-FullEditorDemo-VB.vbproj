<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FullEditorDemoVB</RootNamespace>
    <!-- WindowsFormsWithCustomSubMain: keep My.Application's WinForms helpers available but
         suppress the auto-generated My.MyApplication.Main so Program.vb's explicit Sub Main
         is the sole entry point. -->
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>FullEditorDemoVB.Program</StartupObject>
    <!-- The control's own NuGet package ships a high-DPI app.manifest by design; silence the
         build hint suggesting ApplicationHighDpiMode instead, which would conflict with it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpiceLogic.HtmlEditor.WinForms" Version="*" />
  </ItemGroup>

</Project>
