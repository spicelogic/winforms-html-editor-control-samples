<Project>

  <PropertyGroup>
    <!-- Change this one line to build every sample against a different .NET version.
         The control ships binaries for all of these:
           net48  net472  net45          (.NET Framework)
           net8.0-windows  net9.0-windows  net10.0-windows
           net5.0-windows  net6.0-windows  net7.0-windows
         net48 is the default because .NET Framework 4.8 is part of Windows 10 (1903 and
         later) and Windows 11, so these samples run on a stock Windows machine with nothing
         installed. Point it at a modern target the moment your own application uses one. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- .NET Framework targets need the reference assemblies package on machines that do not
       have the classic targeting pack installed (most modern dev boxes with only the .NET
       SDK do not). Conditioned on TargetFramework, not TargetFrameworkIdentifier: the
       identifier is inferred by the SDK targets, which run after this file, so it is still
       empty here and the condition would never match. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
